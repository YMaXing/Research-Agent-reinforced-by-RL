# Shared environment values used by composed_server_script.py
# Copy to .env in this directory and fill the values.
# Mirrors the keys read by research_agent_local/mcp_server/.env.example and
# writing_workflow/.env.example - check those for the authoritative list.

GOOGLE_API_KEY=...
XAI_API_KEY=...
ANTHROPIC_API_KEY=...
TAVILY_API_KEY=...
JINA_API_KEY=...
FIRECRAWL_API_KEY=...
GITHUB_TOKEN=...

# Opik monitoring
OPIK_API_KEY=...
# Optional; include if your Opik account uses a non-default workspace
OPIK_WORKSPACE=...
OPIK_PROJECT_NAME=nova-brown-composed
